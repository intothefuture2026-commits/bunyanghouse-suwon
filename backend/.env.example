# 솔라피 문자발송 서버(Cloudflare Worker)에 등록할 환경변수
# 실제 값은 여기 적지 말고, Cloudflare 대시보드 → Worker → Settings → Variables and Secrets 에
# "Secret" 으로 직접 등록하세요. 이 파일은 변수 "이름" 참고용입니다.

# 솔라피 내 정보 → API Key 관리 에서 발급
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 솔라피에 사전 등록·인증한 발신번호 (하이픈 없이, 예: 01012345678)
# ※ 예전 이름 SENDER_NUMBER 도 계속 인식됩니다
SOLAPI_SENDER_NUMBER=

# 상담신청 알림을 받을 관리자 번호 (하이픈 없이). 여러 명이면 콤마로 구분
ADMIN_NUMBER=

# 폼이 올라간 사이트 주소 (예: https://example.com). 여러 개면 콤마로 구분
# 미설정 시 모든 Origin 허용(느슨). 운영 시에는 실제 도메인 지정 권장
ALLOWED_ORIGIN=

# (선택) 문자 제목에 쓸 사업명. 기본값 "힐스테이트 수원파크포레"
SITE_NAME=

# (선택) "1" 이면 실제 문자 발송 없이 로그만 남김 — 개발/테스트용
DRY_RUN=

# (선택) "0" 이면 신청자에게 가는 자동 회신 문자를 끔 (기본값: 보냄)
NOTIFY_APPLICANT=
